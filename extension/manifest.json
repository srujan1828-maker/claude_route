{
  "manifest_version": 3,
  "name": "Claude Web Bridge",
  "version": "1.0.0",
  "description": "Bridges claude.ai to a local OpenAI-compatible API server via WebSocket",
  "permissions": ["tabs", "activeTab", "alarms", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

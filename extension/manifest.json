{
  "manifest_version": 3,
  "name": "Claude Web Bridge",
  "version": "2.0.0",
  "description": "Bridges claude.ai to a local or cloud OpenAI-compatible API server via WebSocket",
  "permissions": ["tabs", "activeTab", "alarms", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:8080/*",
    "https://*.fly.dev/*",
    "https://*.railway.app/*",
    "https://*.onrender.com/*",
    "wss://*.fly.dev/*",
    "wss://*.railway.app/*",
    "wss://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
